# Supabase Configuration (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Gemini API Keys (At least one REQUIRED)
GEMINI_API_KEY=your-primary-api-key
GEMINI_CROP_API_KEY=your-crop-specific-api-key

# Application Configuration (OPTIONAL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Signing Secret for Webhooks (OPTIONAL)
SIGNING_SECRET=your-webhook-signing-secret

# Upstash Redis Configuration (OPTIONAL - for scalable rate limiting)
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-redis-token
